{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "strict": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@sandlada/okyct": ["../typescript/src/index.ts"],
      "@sandlada/okyct/*": ["../typescript/src/*"]
    }
  },
  "include": ["src/**/*"]
}
