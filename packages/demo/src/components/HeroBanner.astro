---
---

<section id="overview" class="m3-hero">
  <div class="m3-hero-content">
    <div class="m3-hero-eyebrow">
      <span class="m3-badge">@sandlada/okyct · 0.0.1-20261114.b</span>
    </div>

    <h1 class="m3-hero-title">
      Material Design 3,<br />
      <span>Perceptually Solved.</span>
    </h1>

    <p class="m3-hero-desc">
      OKLab polar hue + bijective CIE Y Tone with Newton-Raphson solver, zero-hue-drift gamut mapping, and OLED display physics.
    </p>

    <div class="m3-hero-actions">
      <button type="button" class="m3-btn m3-btn-filled" data-switch-panel="2">Customize Tokens</button>
      <button type="button" class="m3-btn m3-btn-tonal" data-switch-panel="1">Explore Widgets</button>
    </div>
  </div>

  <div class="m3-hero-visual" aria-hidden="true">
    <div class="m3-art-card">
      <div class="m3-art-shapes">
        <div class="m3-shape-circle"></div>
        <div class="m3-shape-arch"></div>
        <div class="m3-shape-pill"></div>
      </div>

      <div class="m3-telemetry-grid">
        <div class="m3-telemetry-item">
          <span class="m3-telemetry-label">Seed OKYCT</span>
          <strong class="m3-telemetry-value" id="hero-okyct-readout">H 285° · C 0.14 · T 40</strong>
        </div>
        <div class="m3-telemetry-item">
          <span class="m3-telemetry-label">OLED Power</span>
          <strong class="m3-telemetry-value" id="hero-power-readout">—</strong>
        </div>
        <div class="m3-telemetry-item">
          <span class="m3-telemetry-label">Contrast</span>
          <strong class="m3-telemetry-value" id="hero-audit-readout">WCAG AA</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .m3-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: 20px 24px;
    border-radius: 22px;
    background-color: var(--md-sys-color-surface-container-low);
    transition: var(--m3-transition-color);
  }

  .m3-hero-eyebrow {
    margin-bottom: 10px;
  }

  .m3-hero-title {
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--md-sys-color-on-surface);
  }

  .m3-hero-title span {
    color: var(--md-sys-color-primary);
  }

  .m3-hero-desc {
    margin-top: 10px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--md-sys-color-on-surface-variant);
    max-width: 52ch;
  }

  .m3-hero-actions {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .m3-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    padding: 0 18px;
    border-radius: var(--md-sys-shape-corner-full);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: transform 140ms ease;
  }

  .m3-btn:hover {
    transform: translateY(-1px);
  }

  .m3-btn-filled {
    background-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .m3-btn-tonal {
    background-color: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
  }

  .m3-art-card {
    width: 100%;
    border-radius: 22px;
    padding: 16px;
    background-color: var(--md-sys-color-surface-container-high);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .m3-art-shapes {
    height: 112px;
    border-radius: 16px;
    overflow: hidden;
    background-color: var(--md-sys-color-primary-container);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 12px;
  }

  .m3-shape-circle {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    background-color: var(--md-sys-color-primary);
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .m3-shape-arch {
    width: 62px;
    height: 76px;
    border-radius: 32px 32px 10px 10px;
    background-color: var(--md-sys-color-tertiary);
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .m3-shape-pill {
    width: 38px;
    height: 76px;
    border-radius: 999px;
    background-color: var(--md-sys-color-secondary);
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .m3-art-card:hover .m3-shape-circle {
    transform: translateY(-3px) scale(1.04);
  }

  .m3-art-card:hover .m3-shape-arch {
    transform: translateY(2px);
  }

  .m3-art-card:hover .m3-shape-pill {
    transform: translateY(-2px) rotate(4deg);
  }

  .m3-telemetry-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .m3-telemetry-item {
    padding: 9px 10px;
    border-radius: 12px;
    background-color: var(--md-sys-color-surface);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .m3-telemetry-label {
    font-size: 0.68rem;
    color: var(--md-sys-color-on-surface-variant);
    font-weight: 500;
  }

  .m3-telemetry-value {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--md-sys-color-on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 980px) {
    .m3-hero {
      grid-template-columns: 1fr;
      padding: 20px;
    }
  }

  @media (max-width: 600px) {
    .m3-telemetry-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
