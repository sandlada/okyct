{
  "name": "@sandlada/okyct",
  "version": "0.0.1-20261114.c",
  "description": "OKYCT Perceptual Color Space & MD3 Theme Engine for Emissive Displays",
  "keywords": [
    "okyct",
    "color",
    "color-space",
    "oklab",
    "oklch",
    "perceptual-color",
    "material-design",
    "md3",
    "design-tokens",
    "theme-engine",
    "oled",
    "amoled",
    "micro-oled",
    "wcag",
    "apca",
    "accessibility",
    "contrast",
    "gamut-mapping",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/okyct.iife.min.js",
    "jsdelivr": "./dist/okyct.iife.min.js",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./domain": {
        "types": "./dist/domain/index.d.ts",
        "import": "./dist/domain/index.js",
        "default": "./dist/domain/index.js"
      },
      "./ports": {
        "types": "./dist/ports/index.d.ts",
        "import": "./dist/ports/index.js",
        "default": "./dist/ports/index.js"
      },
      "./application": {
        "types": "./dist/application/index.d.ts",
        "import": "./dist/application/index.js",
        "default": "./dist/application/index.js"
      },
      "./adapters": {
        "types": "./dist/adapters/index.d.ts",
        "import": "./dist/adapters/index.js",
        "default": "./dist/adapters/index.js"
      }
    }
  },
  "homepage": "https://github.com/sandlada/okyct#readme",
  "bugs": {
    "url": "https://github.com/sandlada/okyct/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandlada/okyct.git",
    "directory": "packages/typescript"
  },
  "author": "Kai Orion, Sandlada",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "import": "./src/domain/index.ts",
      "default": "./src/domain/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "import": "./src/ports/index.ts",
      "default": "./src/ports/index.ts"
    },
    "./application": {
      "types": "./src/application/index.ts",
      "import": "./src/application/index.ts",
      "default": "./src/application/index.ts"
    },
    "./adapters": {
      "types": "./src/adapters/index.ts",
      "import": "./src/adapters/index.ts",
      "default": "./src/adapters/index.ts"
    }
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "lint": "tsc --noEmit && node --experimental-strip-types scripts/verify-architecture.ts",
    "test": "node --experimental-strip-types --test test/**/*.test.ts src/**/*.unit-test.ts",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
